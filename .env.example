# Salin ke .env.local dan isi. Jalankan `npm run env:check` setelahnya untuk lihat
# fitur mana yang sudah siap — logikanya ada di scripts/check-env.mjs, sumber
# kebenaran tunggal soal env mana wajib untuk fitur mana (jangan duplikasi di sini).

# --- Core (wajib supaya app bisa jalan sama sekali) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=

# --- Feature toggle (default: aktif kecuali diisi "0"/"false"/"no"/"off") ---
NEXT_PUBLIC_ENABLE_AUTH=
NEXT_PUBLIC_ENABLE_WAITLIST=
NEXT_PUBLIC_ENABLE_CONTACT=
NEXT_PUBLIC_ENABLE_PAYMENTS=
NEXT_PUBLIC_ENABLE_ADMIN=
NEXT_PUBLIC_ENABLE_AI=
NEXT_PUBLIC_ENABLE_KOIN=

# --- Email / kontak (cuma perlu kalau NEXT_PUBLIC_ENABLE_CONTACT=true) ---
RESEND_API_KEY=
EMAIL_FROM=Nama Bisnis <noreply@namadomain.id>  # WAJIB diganti per klien, contoh dummy di atas
CONTACT_EMAIL=kontak@namadomain.id    # WAJIB diisi per klien — form kontak gagal (503) kalau kosong,
                              # sengaja gak ada fallback biar pesan gak nyasar ke inbox salah, contoh dummy di atas

# --- Rekening transfer manual (dipakai /toko, /checkout subscription, dan Koin —
# satu sumber: bayar cuma lewat transfer manual + bukti + admin approve, TANPA
# gateway fee-persentase seperti Midtrans/Doku). Nilai di bawah CONTOH DUMMY —
# ganti dengan rekening asli kamu sebelum deploy. ---
NEXT_PUBLIC_PAYMENT_BANK_ACCOUNT=1234567890
NEXT_PUBLIC_PAYMENT_BANK_ACCOUNT_NAME=Nama Pemilik Rekening
NEXT_PUBLIC_PAYMENT_BANK_NAME=BCA
NEXT_PUBLIC_PAYMENT_QRIS_IMAGE=      # path gambar di /public, mis. /qris.jpg
NEXT_PUBLIC_PAYMENT_QRIS_LABEL=QRIS
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890  # format 62xxx, tanpa +/spasi — contoh dummy
NEXT_PUBLIC_TELEGRAM_HANDLE=namaakun        # tanpa @ dan tanpa t.me/ — contoh dummy

# --- Katalog toko (opsional — /toko sembunyiin grid produk kalau kosong) ---
# Array JSON produk yang tampil di /toko. Sengaja lewat env, bukan hardcode di
# kode, biar repo yang sama bisa dipakai jual produk sendiri maupun dijual ke
# klien lain tanpa bawa-bawa katalog bisnis pemilik sebelumnya. Tiap deployment
# (avathur.id, atau instalasi klien) isi env ini sendiri-sendiri di .env.local.
# icon: salah satu dari book-open, bot, handshake, lightbulb, pen-line, user-check
# (di luar itu fallback ke ikon generik). Contoh 1 baris:
# Contoh dummy (ganti sebelum deploy beneran, atau kosongkan lagi kalau belum siap):
PRODUK_KATALOG_JSON=[{"icon":"bot","title":"Nama Produk","desc":"Deskripsi singkat produk kamu","price":"Rp99rb","label":"Produk Digital","href":"/produk-a"}]

# --- CORS waitlist (opsional) ---
NEXT_PUBLIC_WAITLIST_EXTRA_ORIGINS=  # comma-separated, buat gerbang/landing di domain lain

# --- Admin bootstrap ---
ADMIN_EMAILS=                # comma-separated. Bootstrap SEKALI PAKAI: baru dipakai
                              # kalau user itu login pertama kali & belum punya baris
                              # di tabel user_roles (lib/data/user-roles.ts). Isi dgn
                              # emailmu sendiri SEBELUM login pertama ke situs baru.

# --- AI (cuma perlu kalau NEXT_PUBLIC_ENABLE_AI=true) ---
AI_DEFAULT_PROVIDER=         # openai | anthropic | google (default: openai)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=  # Gemini via Google AI Studio (aistudio.google.com) — punya tier gratis

# ---------------------------------------------------------------------------
# Lisensi (Business Source License)
# ---------------------------------------------------------------------------

# License key untuk instance PRODUKSI yang diakses publik. Kosongkan untuk
# development / server internal (mode terbatas berlaku di produksi tanpa key).
# Dapat dari lisensi@avathur.id setelah pembayaran.
BAPIKIR_LICENSE_KEY=

# Opsional. "production" | "development" — override deteksi otomatis dari NODE_ENV.
# BAPIKIR_ENV=

# Opsional. "eval" = lewati kewajiban key sementara (time-box sendiri). Untuk demo.
# BAPIKIR_LICENSE_MODE=

# Opsional. URL endpoint aktivasi/pencabutan (default: https://avathur.id/api/license/activate).
# BAPIKIR_ACTIVATION_URL=

# Opsional. "1" untuk matikan pengecekan aktivasi/pencabutan online sepenuhnya
# (verifikasi offline tetap jalan). Default: aktif, fail-open, non-blocking.
# BAPIKIR_ACTIVATION_DISABLED=

# Opsional. Id instance untuk penghitungan (default: hostname / id deploy platform).
# BAPIKIR_INSTANCE_ID=

# Opsional. Override public key Licensor (untuk staging/test). Kalau kosong,
# pakai yang di-bake di lib/license/verify.ts.
# LICENSOR_PUBLIC_KEY_B64URL=

# ---- Sisi LICENSOR saja (JANGAN taruh di build produk / repo publik) ----
# Private key JWK (base64url) untuk menerbitkan key via scripts/license-cli.mjs.
# Simpan di password manager, sediakan hanya saat menjalankan `issue`.
# LICENSOR_PRIVATE_KEY_JWK_B64=
